{
  "name": "crossknowledge/subconverter-bundle",
  "description": "Implementation of subtitles converter with following supported formats: srt, webvtt, ttaf1, txt, tabtxt",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "subtitle",
    "converter",
    "srt",
    "webvtt",
    "ttaf1",
    "txt",
    "tabtxt",
    "Symfony"
  ],
  "authors": [
    {
      "name": "CrossKnowledge"
    }
  ],
  "autoload": {
    "psr-4": { "CrossKnowledge\\SubConverterBundle\\": "" }
  },
  "require": {
    "php": ">=7.4",
    "symfony/framework-bundle": "5.4.*",
    "symfony/flex": "^1.15"
  },
  "require-dev": {
    "phpunit/phpunit": "^8",
    "symfony/phpunit-bridge": "^6"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  }
}
